# This is a JetBrains scratches directory, so it holds a lot besides practice code:
# Python virtualenvs, .pyc/.so binaries, unrelated projects, reference PDFs, and
# personal credentials. Track ONLY the practice material under AAScratches.

# Ignore everything by default...
*
# ...but descend into directories so the allow-list below can match.
!*/

# ...then allow back exactly what belongs in this repo.
!AAScratches/**/*.java
!AAScratches/**/*.md
!AAScratches/**/*.sql
!AAScratches/**/*.txt
!AAScratches/**/*.properties
!AAScratches/**/pom.xml
# Python, JavaScript and UI practice files (8 Oct 2026; Code Viewer runs them)
!AAScratches/**/*.py
!AAScratches/**/*.js
!AAScratches/**/*.mjs
!AAScratches/**/*.html
!/.gitignore
!/.gitattributes
!/*.md
!/tools/*.py
!/tools/mustknow.json
!/tools/runjava
!/tools/codeview
!/tools/codeview.cmd
!/tools/codeview.html
!/tools/codeview.ico
!/tools/CvAssist.java
!/tools/ui_tests/*.mjs

# --- Re-exclusions. These come AFTER the allow-list so they win. ---

# Credentials and personal data. NEVER commit, whatever the allow-list says above.
# Git is deliberately not a backup for these - keep them in a password manager.
AAScratches/_personal/
**/*credentials*
**/*.env
api_keys.text
**/api_keys*

# Python and Node environments and caches, should one ever sit inside AAScratches.
**/venv/
**/.venv/
**/node_modules/
**/__pycache__/

# IDE state and OS junk: machine-specific, churns constantly, zero value to a reader.
**/.idea/
**/.DS_Store
**/*.iml

# Reference books and large binaries. Third-party material, 58 MB, and not ours to
# publish. Back these up outside git.
AAScratches/08-Reference/Pdfs/
AAScratches/08-Reference/images/
*.pdf
*.xlsx
*.jpg
*.jpeg
*.png

# Unrelated work that happens to live in this folder.
/Learn-HLD/
/Personal/

# Local-only reports, regenerated by `verify-scratches`.
/VERIFY-REPORT.json
/VERIFY-REPORT.md
/.doc-scratches-state.json
