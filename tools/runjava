#!/bin/sh
# Run a practice file: compiles it, then runs whichever class declares main().
# Works from macOS/Linux terminals and from Git Bash on Windows.
here=$(cd "$(dirname "$0")" && pwd)
if command -v cygpath >/dev/null 2>&1; then
  # Git Bash on Windows: plain python (python3 there is often the Microsoft Store stub)
  exec python "$(cygpath -w "$here/runjava.py")" "$@"
fi
exec "$(command -v python3 || command -v python)" "$here/runjava.py" "$@"
